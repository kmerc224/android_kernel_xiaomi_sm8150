# Platform
CONFIG_MACH_XIAOMI_RAPHAEL=y

# Audio
CONFIG_SND_SOC_CS35L41=y
CONFIG_MSM_CSPL=y

# Touchscreen
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y

# === HyperOS/MIUI 集成配置 ===
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_PALMSENSOR=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE=y
CONFIG_KPROFILES=y

# === 性能优化 (来自 Bool-X) ===
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_CPU_INPUT_BOOST=y
CONFIG_IOSCHED_ANXIETY=y
CONFIG_IOSCHED_BFQ=y
CONFIG_DEFAULT_IOSCHED="anxiety"
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR2=y
CONFIG_WIREGUARD=y
CONFIG_DRM_MSM_KCAL_CTRL=y
CONFIG_MSM_THERMAL_SIMPLE=y
CONFIG_DSI_FEATURES=y

# === HyperOS/MIUI 集成配置 ===
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_PALMSENSOR=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE=y
CONFIG_KPROFILES=y

# === 性能优化 (来自 Bool-X) ===
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_CPU_INPUT_BOOST=y
CONFIG_IOSCHED_ANXIETY=y
CONFIG_IOSCHED_BFQ=y
CONFIG_DEFAULT_IOSCHED="anxiety"
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BBR2=y
CONFIG_WIREGUARD=y
CONFIG_DRM_MSM_KCAL_CTRL=y
CONFIG_MSM_THERMAL_SIMPLE=y
CONFIG_DSI_FEATURES=y

# =============================================
# HyperOS/MIUI 集成配置 (由 integration-script.sh 追加)
# =============================================

# 小米触控特性 (来自 MiCode)
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_PALMSENSOR=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE=y

# KProfiles (来自 Bool-X)
CONFIG_KPROFILES=y
