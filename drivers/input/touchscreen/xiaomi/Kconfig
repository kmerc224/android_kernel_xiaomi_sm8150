	tristate "Xiaomi touch feature"
	depends on INPUT_TOUCHSCREEN
	help
	  Enable Xiaomi touch feature support.

config TOUCHSCREEN_XIAOMI_TOUCHFEATURE_PALMSENSOR
	tristate "Xiaomi touch palm sensor"
	depends on TOUCHSCREEN_XIAOMI_TOUCHFEATURE

config TOUCHSCREEN_XIAOMI_TOUCHFEATURE_GAMEMODE
	tristate "Xiaomi touch game mode"
	depends on TOUCHSCREEN_XIAOMI_TOUCHFEATURE

